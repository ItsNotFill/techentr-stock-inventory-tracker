# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL (Project Settings > API). Browser and server.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Browser and server.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Server only. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Postgres through the transaction pooler (port 6543). Used by the app at run time.
# The Drizzle client must be created with prepare: false.
DATABASE_URL=

# Postgres through the session pooler (port 5432). Used by drizzle-kit migrations and the seed script.
DATABASE_URL_MIGRATIONS=

# Claude API key. Server only. Leave empty until the AI tasks.
ANTHROPIC_API_KEY=

# Model used by lib/ai. Server only.
AI_MODEL=claude-sonnet-5-5
