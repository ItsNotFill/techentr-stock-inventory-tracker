# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL (Project Settings > API). Browser and server.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Browser and server.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Server only. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Postgres through the transaction pooler (port 6543). Used by the app at run time.
# The Drizzle client must be created with prepare: false.
DATABASE_URL=

# Postgres through the session pooler (port 5432). Used by drizzle-kit migrations and the seed script.
DATABASE_URL_MIGRATIONS=

# Claude API key. Server only. Leave empty until the AI tasks.
ANTHROPIC_API_KEY=

# Model used by lib/ai. Server only.
AI_MODEL=claude-sonnet-5-5

# E-mails (DECISIONS.md 99). All server only. Without RESEND_API_KEY and EMAIL_FROM nothing is
# sent: each scheduled run is logged as skipped, and Settings shows a preview instead.
# Resend API key (re_...), from resend.com > API Keys.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. "Stock <stock@example.com>".
EMAIL_FROM=
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>";
# the cron routes refuse every call without it. Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional: the address used in e-mail links. On Vercel the production domain is used when empty.
APP_URL=
